# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Card artwork is downloaded at build time by scripts/prepare-art.mjs
/public/art
/.cache
/public/apple-touch-icon.png
/public/icon-*.png

# A snapshot of a previous ai.ts, written on demand by scripts/ai-ab.ts.
# A build artefact of the comparison: stale the moment it exists.
/src/game/ai-baseline.ts
